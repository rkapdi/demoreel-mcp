{
  "name": "demoreel-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents record, annotate and polish product demo videos on macOS by driving CleanShot X (unofficial).",
  "type": "module",
  "bin": { "demoreel-mcp": "src/index.js" },
  "files": ["src", "helper/axhelper.swift", "examples", "README.md", "LICENSE"],
  "scripts": {
    "start": "node src/index.js",
    "build:helper": "swiftc -O helper/axhelper.swift -o helper/axhelper",
    "test": "node --test test/unit.test.js"
  },
  "engines": { "node": ">=18" },
  "os": ["darwin"],
  "keywords": ["mcp", "cleanshot", "screen-recording", "demo-video", "annotation", "ffmpeg", "macos", "claude"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  }
}
